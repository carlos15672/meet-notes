# La instalación por defecto funciona sin claves ni servicios externos.
# Rutas opcionales absolutas para un modelo GGUF y llama-completion.exe:
# TEXT_MODEL_PATH=C:/ruta/modelo.gguf
# LLAMA_CPP_EXECUTABLE=C:/ruta/llama-completion.exe
# TEXT_MODEL_TIMEOUT_SECONDS=600
# REUNION_NOTAS_DB=C:/ruta/reuniones.sqlite3
# WHISPER_MODEL_PATH=C:/ruta/modelo-ctranslate2
